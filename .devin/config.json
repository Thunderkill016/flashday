{
  "permissions": {
    "allow": [
      "Read(**)",
      "Exec(git status)",
      "Exec(git diff)",
      "Exec(git log)",
      "Exec(git show)",
      "Exec(git branch)",
      "Exec(git rev-parse)",
      "Exec(git ls-files)",
      "Exec(git ls-tree)",
      "Exec(git cat-file)",
      "Exec(git blame)",
      "Exec(git remote)",
      "Exec(git check-ignore)",
      "Exec(git worktree list)",
      "Exec(git fetch)",
      "Exec(git add)",
      "Exec(npm run)",
      "Exec(npm test)",
      "Exec(node tests/)",
      "Exec(node scripts/)",
      "Exec(node qa-)",
      "Exec(ls)",
      "Exec(pwd)",
      "Exec(which)",
      "Exec(head)",
      "Exec(tail)",
      "Exec(wc)",
      "Exec(file)",
      "Exec(jq)",
      "Exec(diff)",
      "Exec(sort)",
      "Exec(uniq)"
    ],
    "ask": [
      "Exec(git push)",
      "Exec(git commit)",
      "Exec(git checkout)",
      "Exec(git switch)",
      "Exec(git restore)",
      "Exec(git stash)",
      "Exec(git rebase)",
      "Exec(git merge)",
      "Exec(git cherry-pick)",
      "Exec(git revert)",
      "Exec(git tag)",
      "Exec(npm install)",
      "Exec(npm ci)",
      "Exec(npm publish)",
      "Exec(npx)",
      "Exec(node)",
      "Exec(bash)",
      "Exec(sh)",
      "Exec(python)",
      "Exec(python3)",
      "Exec(firebase)",
      "Exec(vercel)",
      "Exec(gh)",
      "Exec(rm)",
      "Exec(env)",
      "Exec(printenv)",
      "Exec(curl)",
      "Exec(wget)",
      "Exec(ssh)",
      "Exec(scp)",
      "Write(.env*)",
      "Write(**/.env*)",
      "Write(firestore.rules)",
      "Write(firestore.indexes.json)",
      "Write(firebase.json)",
      "Write(.firebaserc)"
    ],
    "deny": [
      "Exec(sudo)",
      "Write(.git/**)",
      "mcp__github-mcp-server__merge_pull_request",
      "mcp__github-mcp-server__push_files",
      "mcp__github-mcp-server__create_or_update_file",
      "mcp__github-mcp-server__delete_file",
      "mcp__vercel__*",
      "mcp__supabase-mcp-server__*"
    ]
  },
  "read_config_from": {
    "agents_standard": true,
    "cursor": true,
    "windsurf": true,
    "claude": true,
    "copilot": true,
    "opencode": true,
    "zed": true,
    "vscode": true
  }
}